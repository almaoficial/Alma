{"fase": "exp67-politicas-probe", "bloque": 2, "probe_idx": 0, "pid": "mbpp:115", "slice": "mbpp", "arm": "reflexion", "exito": 0, "reward": 0.05, "costo_usd": 0.001086, "in": 105, "out": 1784, "respuesta_head": "```python\nimport math\n\n\ndef sum_common_divisors(a, b):\n    g = math.gcd(a, b)\n    total = 0\n\n    for d in range(1, math.isqrt(g) + 1):\n        if g % d == 0:\n            total += d\n            other = g // d\n            if other != d:\n                total += other\n\n    return total\n```"}
